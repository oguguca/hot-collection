// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  status    String
  createdAt DateTime @default(now())
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String?
  name        String?
  googleId    String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  garageItems GarageItem[]
}

model HotWheel {
  id                String       @id @default(uuid())
  code              String       @unique
  toyNumber         String?
  name              String
  model             String?
  manufacturer      String       @default("Mattel")
  year              Int?
  series            String?
  collection        String?
  collectionNumber  String?
  seriesNumber      String?
  imageUrl          String?
  packagingImageUrl String?
  description       String?
  variation         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  garageItems       GarageItem[]
}

model GarageItem {
  id         String   @id @default(uuid())
  userId     String
  hotWheelId String
  quantity   Int      @default(1)
  favorite   Boolean  @default(false)
  notes      String?
  addedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotWheel HotWheel @relation(fields: [hotWheelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotWheelId])
}